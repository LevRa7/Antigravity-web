[Unit]
Description=Antigravity Language Server Backend
After=network.target

[Service]
Type=simple
ExecStart=/home/me/Antigravity/resources/bin/language_server --host 127.0.0.1 --port 8085 --grpc-port 9000
Restart=always
RestartSec=3
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/me
Environment=ANTIGRAVITY_PORT=9000
Environment=CASCADE_DEFAULT_MODEL_OVERRIDE=gemini-3.7-flash-high

[Install]
WantedBy=default.target
